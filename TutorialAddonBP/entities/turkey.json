{
  "format_version": "1.26.10",
  "minecraft:entity": {
    "description": {
      "identifier": "tutorial:turkey",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true
    },

    "component_groups": {
      "tutorial:turkey_baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.4
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "wheat",
            "pumpkin_seeds"
          ],
          "pause_growth_items": [ "golden_dandelion" ],
          "reset_growth_items": [ "golden_dandelion" ],
          "grow_up": {
            "event": "minecraft:ageable_grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 5,
          "speed_multiplier": 1.1
        }
      },

      "tutorial:turkey_adult": {
        "minecraft:experience_reward": {
          "on_bred": "Math.Random(1,7)",
          "on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/chicken.json"
        },
        "minecraft:leashable_to": {},
        "minecraft:breedable": {
          "require_tame": false,
          "breeds_with": {
            "tutorial:turkey": {}
          },
          "breed_items": [
            "wheat",
            "pumpkin_seeds"
          ]
        },
        "minecraft:behavior.breed": {
          "priority": 3,
          "speed_multiplier": 1.0
        },
        "minecraft:rideable": {
          "seat_count": 1,
          "family_types": ["baby_undead"],
          "seats": {
            "position": [0.0, 0.48, 0.0]
          }
        }
      }
    },

    "components": {
      "minecraft:offspring": {
        "offspring_pairs": {
          "tutorial:turkey": "tutorial:turkey"
        }
      },
      "minecraft:spawn_egg_interaction": {},
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": ["turkey", "mob"]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 0.8
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 6,
        "max": 6
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:leashable": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.5
      },
      "minecraft:behavior.mount_pathing": {
        "priority": 2,
        "speed_multiplier": 1.5,
        "target_dist": 0.0,
        "track_target": true
      },
      "minecraft:behavior.tempt": {
        "priority": 4,
        "speed_multiplier": 1.0,
        "items": [
          "wheat",
          "pumpkin_seeds"
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 6.0,
        "probability": 0.02
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {
      },
      "minecraft:pushable_by_block": {
      },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:game_event_movement_tracking": {
        "emit_flap": true
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "randomize": [
              {
                "weight": 95,
                "trigger": "minecraft:spawn_adult"
              },
              {
                "weight": 5,
                "add": {
                  "component_groups": ["tutorial:turkey_baby"]
                }
              }
            ]
          }
        ]
      },
      "minecraft:entity_born": {
        "remove": {},
        "add": {
          "component_groups": ["tutorial:turkey_baby"]
        }
    },

      "minecraft:ageable_grow_up": {
        "remove": {
          "component_groups": ["tutorial:turkey_baby"]
        },
        "add": {
          "component_groups": ["tutorial:turkey_adult"]
        }
      },

      "minecraft:spawn_adult": {
        "add": {
          "component_groups": ["tutorial:turkey_adult"]
          }
        }
      }
    }
  }